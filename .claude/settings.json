{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch --show-current)",
      "Bash(git rev-list*)",
      "Bash(git merge-base*)",
      "Bash(git merge origin/main*)",
      "Bash(gh pr create --base main --head dev*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr view*)",
      "Bash(gh pr merge * --squash*)",
      "Bash(gh run list*)",
      "Bash(date -u*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(npm test*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git push origin dev*)",
      "Bash(git push -u origin dev*)",
      "Bash(node tools/sync-agents.mjs*)",
      "Bash(node tools/release.mjs*)",
      "Bash(node tools/token-report.mjs*)"
    ],
    "ask": [
      "Bash(git pull*)",
      "Bash(rm -rf *)"
    ],
    "deny": [
      "Bash(git add -A)",
      "Bash(git add -A *)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/guardrail-hook.mjs\""
          }
        ]
      }
    ]
  }
}
